{
  "name": "inkcadence",
  "version": "2.0.0",
  "description": "Learn your handwriting from your own old assignments, then generate new pages in your own hand — classical glyph synthesis with optional neural personalization. Self-host or SaaS.",
  "keywords": [
    "handwriting",
    "handwriting-generator",
    "handwriting-synthesis",
    "handwriting-style-transfer",
    "ai-handwriting",
    "handwritten-text",
    "assignment-generator",
    "handwriting-font",
    "ink-detection",
    "canvas",
    "vite",
    "offline-first",
    "privacy-first",
    "self-hosted"
  ],
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafzalkalwardev/inkcadence.git"
  },
  "homepage": "https://mafzalkalwardev.github.io/inkcadence/",
  "bugs": {
    "url": "https://github.com/mafzalkalwardev/inkcadence/issues"
  },
  "browser": "index.html",
  "files": [
    "index.html",
    "sheet.html",
    "js/",
    "assets/",
    "web/",
    "server/",
    "ml/"
  ],
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/dev.js",
    "dev:watch": "node --watch server/dev.js",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "build:web": "npm run build --prefix web",
    "migrate": "node server/migrate.js",
    "test": "node test/api.test.js && node test/frontend.test.js && node test/engine.test.js && node test/pipeline.test.js",
    "test:api": "node test/api.test.js",
    "test:pipeline": "node test/pipeline.test.js",
    "fixtures:samples": "python scripts/make_sample_handwriting.py",
    "lint": "node --check server/app.js && node --check server/auth.js && node --check server/packs.js && node --check web/src/main.js",
    "serve:static": "npx --yes serve . -l 4173"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.14",
    "stripe": "^16.2.0"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
