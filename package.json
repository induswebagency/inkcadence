{
  "name": "inkcadence",
  "version": "1.0.0",
  "description": "Learn your handwriting from your own old assignments, then generate new pages in your own hand — same slant, stroke weight, ink colours, letterforms and heading style. Runs entirely in the browser.",
  "keywords": [
    "handwriting",
    "handwriting-generator",
    "handwriting-synthesis",
    "handwriting-style-transfer",
    "ai-handwriting",
    "handwritten-text",
    "assignment-generator",
    "handwriting-font",
    "ink-detection",
    "canvas",
    "vanilla-javascript",
    "offline-first",
    "privacy-first",
    "no-backend"
  ],
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafzalkalwardev/inkcadence.git"
  },
  "homepage": "https://mafzalkalwardev.github.io/inkcadence/",
  "bugs": {
    "url": "https://github.com/mafzalkalwardev/inkcadence/issues"
  },
  "browser": "index.html",
  "files": [
    "index.html",
    "sheet.html",
    "js/",
    "assets/"
  ],
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/dev.js",
    "dev:watch": "node --watch server/dev.js",
    "migrate": "node server/migrate.js",
    "test": "node test/api.test.js && node test/frontend.test.js",
    "serve:static": "npx --yes serve . -l 4173"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
