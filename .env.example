# Copy to .env and fill in. Never commit .env.

# selfhost | saas
DEPLOY_MODE=selfhost

# Postgres connection string.
# Local docker-compose:  postgres://inkcadence:inkcadence@localhost:5432/inkcadence
DATABASE_URL=postgres://inkcadence:inkcadence@localhost:5432/inkcadence

# Optional Redis — enables shared rate limits + ML job keys.
# REDIS_URL=redis://localhost:6379/0

# Optional ML service (compose --profile ml)
# ML_URL=http://localhost:8090
# ML_CALLBACK_SECRET=change-me
# API_PUBLIC_URL=http://localhost:8080

PORT=8080
# HOST=127.0.0.1

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=https://mafzalkalwardev.github.io
# Public app origin for email links / Stripe redirects
APP_ORIGIN=http://localhost:5173

COOKIE_SECURE=0
SESSION_DAYS=30
PG_POOL_MAX=5
TRUST_PROXY=1
BODY_LIMIT=5mb
MAX_PACKS_PER_USER=25

# Email (no-op unless set)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=Inkcadence <noreply@example.com>

# SaaS billing (DEPLOY_MODE=saas)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# ADMIN_USERS=youradmin
# FORCE_WATERMARK=1

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
