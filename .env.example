# Copy to .env and fill in. Never commit .env.

# Postgres connection string.
# Local docker-compose:  postgres://inkcadence:inkcadence@localhost:5432/inkcadence
# Neon / Supabase / Vercel Postgres: paste the connection string they give you.
DATABASE_URL=postgres://inkcadence:inkcadence@localhost:5432/inkcadence

# Port for the VPS entry point. Hosts that assign a port (Render, Railway) set this themselves.
PORT=8080

# Interface to bind. Leave unset in production (listens on all interfaces, behind
# a reverse proxy). `npm run dev` sets 127.0.0.1 so the dev server stays on loopback.
# HOST=127.0.0.1

# Comma-separated list of browser origins allowed to call the API.
# Leave empty when the same server serves the HTML as well as the API.
# GitHub Pages build: https://mafzalkalwardev.github.io
# That page is on another origin, so it authenticates with a bearer token
# (Authorization header) rather than a cookie. Cross-site cookies would need
# SameSite=None and are being phased out by browsers.
CORS_ORIGIN=https://mafzalkalwardev.github.io

# Set to 1 when the site is served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=0

# How long a login lasts, in days.
SESSION_DAYS=30

# Max pooled Postgres connections. Keep at 1-2 on serverless hosts.
PG_POOL_MAX=5
